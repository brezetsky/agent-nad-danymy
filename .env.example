# Скопіюйте цей файл у .env і вставте свій ключ із https://aistudio.google.com/apikey
# Без ключа агент працює в режимі імітації (mock) — без мережі й без реальної LLM.
GEMINI_API_KEY=

# Модель Gemini. Якщо ця недоступна на вашому тарифі — подивіться список у Google AI Studio.
GEMINI_MODEL=gemini-3.5-flash-lite

# Примусово ввімкнути імітацію навіть за наявності ключа: LLM=mock
# LLM=mock
